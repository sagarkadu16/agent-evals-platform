{
  "name": "agent-evals",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:shared": "npm run build -w packages/shared",
    "start": "npm run build:shared && concurrently -n api,web -c blue,green \"npm run start:dev -w apps/api\" \"npm run dev -w apps/web\"",
    "test": "npm run test -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
